# ch14/01_main-chapter-code/langfuse/langfuse.env
# LOCAL DEMO VALUES ONLY. Every port is bound to 127.0.0.1. Regenerate every secret
# (`openssl rand -hex 32`) before you expose this stack to anyone else.
NEXTAUTH_URL=http://localhost:3014
NEXTAUTH_SECRET=60cc69484c0d6cffe242f8a57c2fc6781b766feb240db582
SALT=733045918d52da6d2bbd64fd87de3728
ENCRYPTION_KEY=741d05837b115aa31a5fc1a1db98cc4edd7ffed9231fceeab14a4cd10b0e3f6e
TELEMETRY_ENABLED=false
LANGFUSE_AI_GATEWAY_PORT=3214

POSTGRES_PASSWORD=ch14-postgres
LANGFUSE_DATABASE_URL=postgresql://postgres:ch14-postgres@postgres:5432/postgres
CLICKHOUSE_PASSWORD=ch14-clickhouse
REDIS_AUTH=ch14-redis
MINIO_ROOT_PASSWORD=ch14-miniosecret
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=ch14-miniosecret
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=ch14-miniosecret
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=ch14-miniosecret

# Headless initialization: an org, a project with fixed API keys, and a login, created on first
# start (https://langfuse.com/self-hosting/administration/headless-initialization).
LANGFUSE_INIT_ORG_ID=shopflow
LANGFUSE_INIT_ORG_NAME=ShopFlow
LANGFUSE_INIT_PROJECT_ID=sqlbot
LANGFUSE_INIT_PROJECT_NAME=sqlbot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-ch14-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-ch14-local
LANGFUSE_INIT_USER_EMAIL=admin@shopflow.local
LANGFUSE_INIT_USER_NAME=ShopFlow Admin
LANGFUSE_INIT_USER_PASSWORD=ch14-langfuse-admin
