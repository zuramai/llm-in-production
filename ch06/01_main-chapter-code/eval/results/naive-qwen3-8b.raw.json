      "question": "What is our website conversion rate this month?",
      "answer": null,
      "sql": "SELECT \n  EXTRACT(MONTH FROM o.placed_at) AS month,\n  COUNT(DISTINCT o.id) AS total_orders,\n  COUNT(DISTINCT CASE WHEN p.id IS NOT NULL THEN o.id END) AS paid_orders,\n  ROUND(COUNT(DISTINCT CASE WHEN p.id IS NOT NULL THEN o.id END) * 100.0 / COUNT(DISTINCT o.id), 2) AS conversion_rate\nFROM \n  orders o\nLEFT JOIN \n  payments p ON o.id = p.order_id\nWHERE \n  o.placed_at >= CURRENT_DATE - INTERVAL '1 month'\n  AND o.placed_at < CURRENT_DATE + INTERVAL '1 day'\n  AND o.status = 'completed'\nGROUP BY \n  EXTRACT(MONTH FROM o.placed_at);",
