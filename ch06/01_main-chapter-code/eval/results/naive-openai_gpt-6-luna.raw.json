      "id": "a1",
      "category": "ambiguous",
      "question": "How are sales doing?",
      "answer": null,
      "sql": "WITH refunds_by_order AS (\n  SELECT\n    order_id,\n    SUM(amount_cents) AS refunded_cents\n  FROM refunds\n  GROUP BY order_id\n),\nmonthly_sales AS (\n  SELECT\n    date_trunc('month', o.placed_at) AS month,\n    o.currency,\n    COUNT(*) AS order_count,\n    SUM(o.total_cents) AS gross_sales_cents,\n    SUM(COALESCE(r.refunded_cents, 0)) AS refunds_cents\n  FROM orders o\n  LEFT JOIN refunds_by_order r ON r.order_id = o.id\n  GROUP BY 1, 2\n),\nsales_with_previous_month AS (\n  SELECT\n    *,\n    LAG(gross_sales_cents - refunds_cents) OVER (\n      PARTITION BY currency\n      ORDER BY month\n    ) AS previous_month_net_sales_cents\n  FROM monthly_sales\n)\nSELECT\n  month,\n  currency,\n  order_count,\n  gross_sales_cents,\n  refunds_cents,\n  gross_sales_cents - refunds_cents AS net_sales_cents,\n  ROUND((gross_sales_cents - refunds_cents)::numeric / NULLIF(order_count, 0), 2)\n    AS average_order_value_cents,\n  ROUND(\n    100.0 * (\n      (gross_sales_cents - refunds_cents) - previous_month_net_sales_cents\n    ) / NULLIF(previous_month_net_sales_cents, 0),\n    2\n  ) AS net_sales_change_pct\nFROM sales_with_previous_month\nORDER BY month, currency;",
